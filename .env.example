# Template only. Copy to .env.local and fill in there — .env.local is gitignored.
# This file must never contain a real value.

# -----------------------------------------------------------------------------
# Program waitlist — /estresse-reatividade
# -----------------------------------------------------------------------------
# Two independent switches, both of which must read exactly "live" before a
# single row is stored. Leaving either at "demo" keeps the form a demonstration.
#
#   NEXT_PUBLIC_PROGRAM_WAITLIST_MODE  browser-side. Decides whether the form is
#                                      allowed to call the internal API route at
#                                      all. Inlined into the client bundle at
#                                      build time, so it is public by design —
#                                      it holds a mode name and nothing else.
#
#   PROGRAM_WAITLIST_MODE              server-side. Decides whether that route
#                                      stores anything. Never sent to the
#                                      browser.
#
# Default is demo. In demo mode nothing leaves the browser.

NEXT_PUBLIC_PROGRAM_WAITLIST_MODE=demo
PROGRAM_WAITLIST_MODE=demo

# -----------------------------------------------------------------------------
# Supabase — server-side only
# -----------------------------------------------------------------------------
# Required only when PROGRAM_WAITLIST_MODE=live. With either one missing, the
# API route fails closed and sends nothing anywhere.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. It grants full read and
# write access to every row in the project. Treat it like a database password:
#
#   - never prefix it with NEXT_PUBLIC_ (that would publish it in the JS bundle)
#   - never reference it from a client component
#   - store it only in the host's server-side environment settings
#   - rotate it in the Supabase dashboard if it is ever exposed
#
# Neither variable has a value here on purpose. See
# docs/PROGRAM_WAITLIST_SETUP.md before filling them in.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Rate limiting — server-side only
# -----------------------------------------------------------------------------
# Key for the HMAC digest of the client IP used by the rate limiter. The raw
# address is never stored or logged — only the keyed digest.
#
# It is keyed rather than a plain hash on purpose: the IPv4 space is small
# enough to enumerate exhaustively, so an unkeyed hash of an IP is reversible in
# seconds and would still be personal data at rest.
#
# Required whenever PROGRAM_WAITLIST_MODE=live. Without it the limiter cannot
# run, and the endpoint fails closed rather than accepting unlimited writes.
# Generate one with:  openssl rand -hex 32
#
# Changing this value resets every in-flight rate-limit window. That is
# harmless — old digests simply expire.

PROGRAM_WAITLIST_RATE_SALT=
